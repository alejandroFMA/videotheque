---
import {
  IMDB_CREDIT,
  IMDB_URL,
  OMDB_CREDIT,
  OMDB_LICENSE,
  OMDB_LICENSE_URL,
  OMDB_URL,
  RT_CREDIT,
  RT_URL,
  TMDB_ATTRIBUTION,
  TMDB_LOGO_ALT,
  TMDB_URL,
} from '../constants';

const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<footer>
  <a href={TMDB_URL} target="_blank" rel="noopener noreferrer">
    <img src="/tmdb-logo.svg" alt={TMDB_LOGO_ALT} width="104" height="14" />
  </a>
  <p>{TMDB_ATTRIBUTION}</p>
  <p class="credits">
    <a class="credit" href={OMDB_URL} {...external}>{OMDB_CREDIT}</a>{' ('}<a
      class="credit"
      href={OMDB_LICENSE_URL}
      {...external}>{OMDB_LICENSE}</a
    >{'). '}<a class="credit" href={IMDB_URL} {...external}>{IMDB_CREDIT}</a>{' '}<a
      class="credit"
      href={RT_URL}
      {...external}>{RT_CREDIT}</a
    >
  </p>
</footer>

<style>
  /* TMDB's licence requires the mark to stay visible. It floats at the foot of
     the page rather than sitting in a band. */
  footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 12px;
    padding: 22px var(--gutter) 26px;
  }

  a {
    display: block;
    line-height: 0;
    opacity: 0.85;
  }

  a:hover {
    opacity: 1;
  }

  a.credit {
    display: inline;
    line-height: inherit;
    color: inherit;
    text-underline-offset: 2px;
  }

  /* The score credits read as one small paragraph under TMDB's line. */
  .credits {
    flex-basis: 100%;
  }

  img {
    display: block;
    height: 14px;
    width: auto;
  }

  p {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
