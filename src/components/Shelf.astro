---
import Spine from './Spine.astro';
import { LABEL_ADD, LABEL_EDIT, SHELF_DELETE } from '../constants';
import { parsePostitColor, postitInk } from '../lib/postit';
import { filmsInOrder, type ShelfWithFilms } from '../lib/shelves';

interface Props {
  shelf: ShelfWithFilms;
  editable: boolean;
  /** False on the owner's last shelf: a bookcase with none has nowhere to add. */
  deletable: boolean;
}

const { shelf, editable, deletable } = Astro.props;

// The endpoint validates the colour, but RLS also lets an owner update the row
// directly, and this value is written into a style attribute.
const colour = parsePostitColor(shelf.accent_color);
const ink = colour ? (parsePostitColor(shelf.accent_text_color) ?? postitInk(colour)) : undefined;
const postitStyle = colour ? `--postit:${colour};--postit-ink:${ink}` : undefined;
const label = colour ? shelf.name : null;
---

<article
  class="shelf"
  data-shelf-id={shelf.id}
  data-label-name={label}
  data-label-color={colour}
  data-label-ink={ink}
>
  {
    label && editable && (
      <button type="button" class="postit" style={postitStyle} data-edit-label>
        {label}
        <span class="sr-only"> · {LABEL_EDIT}</span>
      </button>
    )
  }
  {
    label && !editable && (
      <p class="postit" style={postitStyle}>
        {label}
      </p>
    )
  }
  {
    !label && editable && (
      <button type="button" class="label-add" data-edit-label>
        {LABEL_ADD}
      </button>
    )
  }

  <ol class="plank">
    {filmsInOrder(shelf).map((film) => <Spine film={film} />)}
  </ol>

  {
    editable && deletable && (
      <button type="button" class="shelf-delete" data-delete-shelf aria-label={SHELF_DELETE}>
        <span aria-hidden="true">−</span>
      </button>
    )
  }
</article>

<style>
  .shelf {
    /* On the shelf rather than the plank so the delete button can centre on
       the board too. */
    --board: 22px;

    position: relative;
    width: fit-content;
    margin: 64px auto 0;
  }

  /* One <ol> draws as many planks as its spines wrap into: a shelf is always
     twenty films, a plank is however many fit the viewport. The board under
     each row is this element's background, repeated once per row, because the
     row count is the browser's to decide and no element exists per row. */
  .plank {
    --spine-h: 172px;
    /* How far the spines stand in from the board's back edge. */
    --sink: 7px;
    --lip: 9px;
    --between: 40px;
    --board-top: calc(var(--spine-h) - var(--sink));
    --row: calc(var(--board-top) + var(--board));
    --period: calc(var(--row) + var(--between));

    position: relative;
    display: flex;
    flex-wrap: nowrap;
    align-content: flex-start;
    column-gap: 3px;
    row-gap: calc(var(--period) - var(--spine-h));
    width: 756px;
    min-height: var(--row);
    margin: 0;
    padding: 0 14px calc(var(--board) - var(--sink));
    list-style: none;
  }

  .plank::before,
  .plank::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-repeat: repeat-y;
    background-size: 100% var(--period);
  }

  /* The board: real walnut, dimmed to the theme, with the light catching the
     top surface's back edge and the front lip falling into shade. */
  .plank::before {
    background-image:
      linear-gradient(
        to bottom,
        transparent var(--board-top),
        rgba(255, 255, 255, 0.2) var(--board-top),
        rgba(255, 255, 255, 0) calc(var(--board-top) + 2px),
        rgba(0, 0, 0, 0.1) calc(var(--row) - var(--lip)),
        rgba(255, 255, 255, 0.22) calc(var(--row) - var(--lip)),
        rgba(0, 0, 0, 0.34) calc(var(--row) - var(--lip) + 1px),
        rgba(0, 0, 0, 0.52) var(--row),
        transparent var(--row)
      ),
      linear-gradient(var(--wood-dim), var(--wood-dim)), url('/textures/walnut.jpg');
    background-repeat: repeat-y, repeat, repeat;
    background-size:
      100% var(--period),
      auto,
      384px 384px;
    border-radius: 2px;
    mask: linear-gradient(
        to bottom,
        transparent var(--board-top),
        #000 var(--board-top),
        #000 var(--row),
        transparent var(--row)
      )
      0 0 / 100% var(--period) repeat-y;
  }

  /* The board's shadow on the wall. Taller than the element so the last row's
     shadow has somewhere to fall. */
  .plank::after {
    bottom: -16px;
    background-image: linear-gradient(
      to bottom,
      transparent var(--row),
      var(--wall-shadow) var(--row),
      transparent calc(var(--row) + 16px)
    );
  }

  .postit {
    position: absolute;
    left: -12px;
    /* Higher than the addendum's -18px, which put the card over the first
       spine's title. */
    top: -31px;
    z-index: 3;
    margin: 0;
    padding: 7px 13px 6px;
    border: 0;
    transform: rotate(-2.6deg);
    background: var(--postit);
    color: var(--postit-ink);
    font-family: var(--font-postit);
    font-size: 17px;
    line-height: 1.15;
    text-transform: uppercase;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.38);
  }

  button.postit {
    cursor: pointer;
    /* A long press lifts the shelf; the system menu must not open over it. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  /* The pin. */
  .postit::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -5px;
    width: 11px;
    height: 11px;
    margin-left: -5.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f0d9ae, var(--brass) 55%, #6d5126);
    box-shadow: 0 2px 2px rgba(0, 0, 0, 0.4);
  }

  .label-add {
    position: absolute;
    left: 0;
    top: -26px;
    padding: 3px 0;
    background: none;
    border: 0;
    font-size: 11.5px;
    color: var(--muted);
    cursor: pointer;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .shelf:hover .label-add,
  .label-add:focus-visible {
    opacity: 1;
  }

  .label-add:hover {
    color: var(--ink);
  }

  .shelf-delete {
    --size: 20px;

    position: absolute;
    right: -34px;
    /* Centred on the last row's board, which is the plank's bottom edge. */
    bottom: calc(var(--board) / 2 - var(--size) / 2);
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    padding: 0;
    background: none;
    border: 1.5px solid var(--danger);
    border-radius: 50%;
    color: var(--danger);
    font: 600 15px/1 var(--font-ui);
    cursor: pointer;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .shelf:hover .shelf-delete,
  .shelf-delete:focus-visible {
    opacity: 1;
  }

  /* No hover to reveal it on a touch screen. */
  @media (hover: none) {
    .label-add,
    .shelf-delete {
      opacity: 1;
    }
  }

  @media (max-width: 819px) {
    .plank {
      flex-wrap: wrap;
      width: 455px;
    }

    /* Beside the board there is no room left in the viewport at these
       widths; under it, at the right end, it stays with its shelf. */
    .shelf-delete {
      right: 0;
      bottom: -34px;
    }
  }

  @media (max-width: 499px) {
    .plank {
      width: 260px;
    }
  }
</style>
