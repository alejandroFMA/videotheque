---
import AvatarMenu from './AvatarMenu.astro';
import SearchBar from './SearchBar.astro';
import ThemeToggle from './ThemeToggle.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  displayName: string;
  shelvedIds: number[];
}

const { displayName, shelvedIds } = Astro.props;
---

<header>
  <Wordmark variant="bar" />

  <div class="search-slot"><SearchBar shelvedIds={shelvedIds} /></div>

  <div class="cluster">
    <ThemeToggle />
    <AvatarMenu displayName={displayName} />
  </div>
</header>

<style>
  /* No band and no rule: the wall runs unbroken from the top of the page to
     the bottom, the way Attribution already treats the foot. */
  header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px var(--gutter);
  }

  /* search-slot is header's direct child, a sibling of .cluster rather than
     its parent, so the field can take its own row below 640px without
     forcing the toggle and avatar down with it (see the media query). The
     auto margin pushes it, and everything after it, to the right. */
  .search-slot {
    margin-left: auto;
  }

  .cluster {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Two rows below this width: wordmark and the toggle+avatar cluster share
     row one, with the cluster still hard right on its own auto margin; the
     search field — ordered after both and given a 100% basis — no longer
     fits on that row and drops to row two, full width. The name goes too:
     the avatar already identifies the account, and the name is what the
     field needs the room from. */
  @media (max-width: 640px) {
    header {
      flex-wrap: wrap;
      row-gap: 10px;
    }

    .search-slot {
      order: 1;
      flex-basis: 100%;
      margin-left: 0;
    }

    .cluster {
      margin-left: auto;
    }
  }
</style>
