---
import { CASE_CLOSE, CASE_REMOVE } from '../constants';

interface Props {
  editable: boolean;
}

const { editable } = Astro.props;
---

{
  /* The static view the visual spec names as the no-WebGL fallback: the case
     front with its spine to the left, and the record beside it. Filled by the
     bookcase script from the spine that was clicked — never from TMDB. */
}
<dialog id="film-case" aria-labelledby="case-title">
  <div class="case">
    <div class="box">
      <span class="box-spine" aria-hidden="true"><span id="case-spine-title"></span></span>
      <img id="case-cover" alt="" width="300" height="450" />
      <span id="case-blank" class="blank" aria-hidden="true" hidden></span>
    </div>

    <div class="record">
      <h2 id="case-title"></h2>
      <p id="case-meta" class="meta"></p>
      <p id="case-overview" class="overview"></p>
      <p id="case-error" class="error" role="alert"></p>
      <div class="actions">
        {
          editable && (
            <button type="button" id="case-remove" class="remove">
              {CASE_REMOVE}
            </button>
          )
        }
        <button type="button" id="case-close" class="close">{CASE_CLOSE}</button>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* The dialog is the whole viewport, so a click that lands on it rather than
     on .case is a click on the dimmed shelf, which closes it. */
  dialog {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 24px;
    border: 0;
    background: rgba(8, 8, 8, 0.8);
    /* Always light: the record sits on the dimmed shelf in both themes. */
    color: #f4f1ea;
    overflow-y: auto;
  }

  dialog[open] {
    display: grid;
    place-items: center;
    animation: dim 180ms ease;
  }

  dialog::backdrop {
    background: none;
  }

  .case {
    display: flex;
    align-items: center;
    gap: 44px;
    max-width: 860px;
    animation: arrive 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .box {
    display: flex;
    flex: none;
    border-radius: 3px;
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.6),
      0 4px 10px rgba(0, 0, 0, 0.5);
  }

  .box-spine {
    display: flex;
    justify-content: center;
    width: 40px;
    padding: 16px 0;
    border-radius: 3px 0 0 3px;
    color: #171412;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.2), rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0.3)),
      var(--spine, #fff);
  }

  .box-spine.dark {
    color: #f3eee4;
  }

  .box-spine span {
    max-height: 100%;
    overflow: hidden;
    writing-mode: vertical-rl;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-spine);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  #case-cover,
  .blank {
    display: block;
    width: 300px;
    height: 450px;
    border-radius: 0 3px 3px 0;
    object-fit: cover;
    background: var(--spine, #2a2a2a);
  }

  [hidden] {
    display: none !important;
  }

  .record {
    min-width: 0;
    max-width: 400px;
  }

  h2 {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.12;
    text-wrap: balance;
  }

  .meta {
    margin: 10px 0 0;
    font-size: 14px;
    color: #b9b3a9;
  }

  .overview {
    margin: 18px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: #dcd7ce;
  }

  .error {
    margin: 14px 0 0;
    font-size: 13px;
    color: #f0a79b;
  }

  .error:empty {
    display: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .actions button {
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: none;
    color: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  .actions button:hover {
    border-color: #f4f1ea;
  }

  .actions button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  @keyframes dim {
    from {
      background: rgba(8, 8, 8, 0);
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.96);
    }
  }

  @media (max-width: 760px) {
    dialog[open] {
      place-items: start center;
    }

    .case {
      flex-direction: column;
      gap: 26px;
      padding: 16px 0;
    }

    .box-spine {
      width: 28px;
      padding: 12px 0;
    }

    .box-spine span {
      font-size: 12.5px;
    }

    #case-cover,
    .blank {
      width: 188px;
      height: 282px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    dialog[open],
    .case {
      animation: none;
    }
  }
</style>
