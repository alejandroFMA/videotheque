{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "context7",
    "serena",
    "supabase",
    "playwright"
  ],
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-pr-screenshots.sh",
            "statusMessage": "Checking PR screenshots"
          }
        ]
      }
    ]
  }
}
