# Supabase CLI / MCP access (from the Supabase dashboard)
SUPABASE_ACCESS_TOKEN=<SUPABASE_ACCESS_TOKEN>
SUPABASE_DB_PASSWORD=<SUPABASE_DB_PASSWORD>

# TMDB v4 "API Read Access Token" (Bearer), from https://www.themoviedb.org/settings/api
# Server-only: it is never sent to the browser. Read at runtime via astro:env.
TMDB_ACCESS_TOKEN=
